# Copy to .env and fill in the keys you have. DexBot auto-detects providers.
# The built-in demo provider works with no keys at all.

# xAI (Grok)
XAI_API_KEY=

# OpenAI (GPT + images)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini + Imagen)
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter (one key, many models)
OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=http://localhost
# OPENROUTER_APP_NAME=DexBot

# DeepSeek
DEEPSEEK_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Local models through Ollama (no key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Pick a default provider and give the server a data directory
# DEXBOT_DEFAULT_PROVIDER=xai
# DEXBOT_DATA_DIR=./data
# DEXBOT_READ_TIMEOUT=300

# Model lists can be overridden without touching code
# XAI_MODELS=grok-4,grok-3,grok-3-mini
# XAI_IMAGE_MODELS=grok-2-image
# OPENAI_MODELS=gpt-4.1,gpt-4o,o3,o4-mini
# OPENAI_IMAGE_MODELS=gpt-image-1,dall-e-3
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5
# GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash
# GOOGLE_IMAGE_MODELS=imagen-4.0-generate-001,imagen-3.0-generate-002
# OLLAMA_MODELS=llama3.2,qwen3,mistral

# Add any OpenAI-compatible API as JSON (or create providers.json)
# DEXBOT_PROVIDERS_JSON=[{"id":"my-api","label":"My API","base_url":"https://example.com/v1","key_env":"MY_API_KEY","models":["my-model"],"image_models":["my-image"]}]
